    function checkGraph(uint8 decimals, uint16 bps, uint32 scope, uint256 mask, bool isBuy, uint256 ideal, uint256 maximum) private pure {
        uint128 unit = uint128(10 ** uint256(decimals));
        L.Market memory m;
        m.events = 3; m.decimals = decimals; m.initialDepth = 100 * unit; m.rate = L.depthRate(3, bps);
        m.order = new uint8[](3); m.order[0] = 2; m.order[1] = 0; m.order[2] = 1;
        m.factors = new Q.Factor[](5);
        uint32[5] memory scopes = [uint32(0), 1, 6, 5, 7];
        for (uint256 i; i < scopes.length; i++) {
            uint256 size;
            for (uint32 s = scopes[i]; s != 0; s &= s-1) size++;
            m.factors[i].scope = scopes[i];
            m.factors[i].values = new uint128[](1 << size);
            for (uint256 j; j < m.factors[i].values.length; j++) {
                m.factors[i].values[j] = 20 * unit + uint128((i*7 + j*13) % 43) * unit / 10;
            }
        }
        Q.Quote memory result = isBuy ? L.buy(m, scope, mask, 10*unit, 10*unit) : L.sell(m, scope, mask, 10*unit, 1);
        assert(result.maxLiabilityAfter == maximum);
        checkBounds(m, result, isBuy, ideal);
    }
    function checkTwo(uint128 startYes, uint32 scope, uint256 mask, uint128 quantity, bool isBuy, uint256 ideal, uint256 depthAfterWad) private pure {
        L.Market memory m;
        m.events = 2; m.decimals = 6; m.initialDepth = 10e6; m.rate = L.depthRate(2, 500);
        m.order = new uint8[](2); m.order[1] = 1;
        if (startYes != 0) {
            m.factors = new Q.Factor[](1);
            m.factors[0].scope = 1;
            m.factors[0].values = new uint128[](2);
            m.factors[0].values[1] = startYes;
        }
        Q.Quote memory result = isBuy ? L.buy(m, scope, mask, quantity, quantity) : L.sell(m, scope, mask, quantity, 1);
        assert(L.depthWad(uint256(m.initialDepth) * 1e12, m.rate, Q.toWad(result.factorsAfter, 1e12)) == depthAfterWad);
        checkBounds(m, result, isBuy, ideal);
    }
    function checkBounds(L.Market memory m, Q.Quote memory result, bool isBuy, uint256 ideal) private pure {
        uint256 scale = 10 ** (18 - uint256(m.decimals));
        uint256 depthBefore = L.currentDepth(m);
        uint256 depthAfter = L.depthWad(uint256(m.initialDepth) * scale, m.rate, Q.toWad(result.factorsAfter, scale));
        uint256 numerator = (ceilDiv(depthBefore, scale) + ceilDiv(depthAfter, scale)) * 82048;
        uint256 allowance = ceilDiv(numerator, 1e18) + 3;
        if (isBuy) assert(result.collateral >= ideal && result.collateral - ideal <= allowance);
        else assert(result.collateral <= ideal && ideal - result.collateral <= allowance);
    }
    function ceilDiv(uint256 a, uint256 b) private pure returns (uint256) {
        return a / b + (a % b == 0 ? 0 : 1);
    }
